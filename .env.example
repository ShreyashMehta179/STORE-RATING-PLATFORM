# =============================================
# StoreHub Server — Environment Variables
# =============================================
# Copy this file to server/.env and fill in values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — Prisma reads this automatically
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storehub_db?schema=public"

# JWT Authentication
JWT_SECRET="storehub_super_secret_jwt_key_change_this_in_production"
JWT_EXPIRES_IN="7d"

# CORS — deployed frontend URL (e.g. https://storehub.onrender.com)
CLIENT_URL="http://localhost:5173"
